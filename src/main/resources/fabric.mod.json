{
  "schemaVersion": 1,
  "id": "claudemc",
  "version": "${version}",
  "name": "ClaudeMC",
  "description": "Prompt Claude Code from inside Minecraft. Claude proposes WorldEdit commands; you approve and run them with a click.",
  "authors": ["omeldar"],
  "contact": {
    "homepage": "https://github.com/omeldar/claude-mc",
    "sources": "https://github.com/omeldar/claude-mc",
    "issues": "https://github.com/omeldar/claude-mc/issues"
  },
  "license": "MIT",
  "icon": "assets/claudemc/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["com.omeldar.claudemc.ClaudeMCClient"],
    "modmenu": ["com.omeldar.claudemc.ModMenuIntegration"]
  },
  "mixins": [
    {
      "config": "claudemc.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "worldedit": "*",
    "modmenu": "*"
  }
}
