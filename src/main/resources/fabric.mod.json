{
  "schemaVersion": 1,
  "id": "lumipet",
  "version": "${version}",
  "name": "Lumi",
  "description": "Lumi is a happy little block pet and your AI assistant in Minecraft. Runs on your own Claude Code install. Unofficial: not made or endorsed by Anthropic, Mojang or Microsoft.",
  "authors": ["omeldar"],
  "contact": {
    "homepage": "https://github.com/omeldar/claude-mc",
    "sources": "https://github.com/omeldar/claude-mc",
    "issues": "https://github.com/omeldar/claude-mc/issues"
  },
  "license": "MIT",
  "icon": "assets/lumipet/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["com.omeldar.lumi.LumiClient"],
    "modmenu": ["com.omeldar.lumi.ModMenuIntegration"]
  },
  "mixins": [
    {
      "config": "lumipet.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "worldedit": "*",
    "modmenu": "*"
  }
}
